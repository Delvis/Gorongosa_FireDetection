library(ggplot2)
library(dplyr)
library(sf)
library(lubridate)
library(purrr) # For efficient list binding
# -------------------------------
# 0. DATASET SELECTION & SOURCES
# -------------------------------
source("R/viirs_regions.R")
source("R/viirs_summary.R")
# Find all available fire cache files
cache_files <- list.files("cache", pattern = "fires_\\d{4}_sf.rds", full.names = TRUE)
if (length(cache_files) == 0) stop("No cache files found in cache/ folder.")
# Load and combine all years
all_years_sf <- map_df(cache_files, function(file) {
year_val <- as.numeric(gsub("\\D", "", basename(file)))
readRDS(file) %>% mutate(year = year_val)
})
# -------------------------------
# 1. Load regions
# -------------------------------
regions_list <- load_viirs_regions()
# -------------------------------
# 2. Build monthly summary
# -------------------------------
# Note: Ensure build_monthly_summary handles the 'year' column or group by it
monthly_all <- build_monthly_summary(all_years_sf, regions_list)
# -------------------------------
# 3. Region areas (km²)
# -------------------------------
region_areas <- sapply(regions_list, function(x) {
as.numeric(st_area(x)) / 1e6
})
# -------------------------------
# 4. Monthly fires per km²
# -------------------------------
plot_data <- monthly_all |>
mutate(
area_km2 = region_areas[region],
fires_per_km2 = n_fires / area_km2,
month = factor(month, levels = month.name) # Chronological order
) |>
filter(region %in% c("GNP", "Mountain", "Buffer"))
# -------------------------------
# 5. Plot (Facetted by Year)
# -------------------------------
p <- ggplot(plot_data,
aes(x = month, y = fires_per_km2, fill = region)) +
geom_col(position = "dodge") +
# This creates the vertical stack of years
facet_grid(year ~ ., switch = "y") +
scale_fill_manual(values = c("GNP" = "#27ae60",
"Mountain" = "#2980b9",
"Buffer" = "#f1c40f")) +
labs(
x = "Month",
y = "Fires per km²",
fill = "Region",
title = "Historical Fire Density Comparison"
) +
theme_minimal(base_size = 12) +
theme(
axis.text.x = element_text(angle = 45, hjust = 1),
legend.position = "bottom",
strip.text.y = element_text(angle = 0, face = "bold"), # Keep year labels horizontal
panel.spacing = unit(1, "lines"),
panel.grid.minor = element_blank()
)
print(p)
# -------------------------------
# 6. Save plot (Adjust height based on number of years)
# -------------------------------
num_years <- length(unique(plot_data$year))
outfile <- "plots/monthly_fires_multiyear_stacked.png"
dir.create("plots", showWarnings = FALSE)
# Scale height dynamically: roughly 3 inches per year + 2 for labels/legend
ggsave(outfile, plot = p, width = 10, height = (2 * num_years) + 2, dpi = 300, bg = "white")
message("Saved multi-year plot: ", outfile)
library(ggplot2)
library(dplyr)
library(sf)
library(lubridate)
# -------------------------------
# 0. DATASET SELECTION & SOURCES
# -------------------------------
source("R/viirs_regions.R")
source("R/viirs_summary.R")
# Define file paths based on your cache structure
file_archive <- "cache/viirs_archive_clean.rds" # 2017-2024
file_2025    <- "cache/fires_2025_sf.rds"       # 2025
file_latest  <- "cache/fires_sf_latest.rds"     # 2026
# Load and combine sources
# We ensure they are all SF objects with the necessary columns
list_of_fires <- list()
if (file.exists(file_archive)) {
# The archive is likely a data.table/frame; convert to SF
arch_raw <- readRDS(file_archive)
list_of_fires$archive <- arch_raw %>%
mutate(acq_date = as.Date(acq_date)) %>%
st_as_sf(coords = c("longitude", "latitude"), crs = 4326, remove = FALSE)
}
if (file.exists(file_2025))   list_of_fires$y2025  <- readRDS(file_2025)
if (file.exists(file_latest)) list_of_fires$latest <- readRDS(file_latest)
# Combine all years into one master SF object
all_fires_sf <- bind_rows(list_of_fires)
gc()
library(ggplot2)
library(dplyr)
library(sf)
library(lubridate)
# -------------------------------
# 0. DATASET SELECTION & SOURCES
# -------------------------------
source("R/viirs_regions.R")
source("R/viirs_summary.R")
# File paths
file_archive <- "cache/viirs_archive_clean.rds"
file_2025    <- "cache/fires_2025_sf.rds"
file_latest  <- "cache/fires_sf_latest.rds"
load_and_standardize <- function(path) {
if (!file.exists(path)) return(NULL)
data <- readRDS(path)
# Ensure it is an sf object (Archive might be a data.table)
if (!inherits(data, "sf")) {
data <- data %>%
st_as_sf(coords = c("longitude", "latitude"), crs = 4326, remove = FALSE)
}
# Standardize acq_date to Date class to prevent the bind_rows error
data <- data %>%
mutate(acq_date = as.Date(acq_date))
return(data)
}
# Load all available sources safely
list_of_fires <- list(
archive = load_and_standardize(file_archive),
y2025   = load_and_standardize(file_2025),
latest  = load_and_standardize(file_latest)
)
# Filter out NULLs and combine
all_fires_sf <- bind_rows(compact(list_of_fires))
str(list_of_fires)
library(ggplot2)
library(dplyr)
library(sf)
library(lubridate)
# -------------------------------
# 0. DATASET SELECTION & SOURCES
# -------------------------------
source("R/viirs_regions.R")
source("R/viirs_summary.R")
# File paths
file_archive <- "cache/viirs_archive_clean.rds"
file_2025    <- "cache/fires_2025_sf.rds"
file_latest  <- "cache/fires_sf_latest.rds"
load_and_standardize <- function(path) {
if (!file.exists(path)) return(NULL)
data <- readRDS(path)
# 1. Convert to sf if it's just a data.table/frame
if (!inherits(data, "sf")) {
data <- st_as_sf(data, coords = c("longitude", "latitude"), crs = 4326, remove = FALSE)
}
# 2. FORCE acq_date to standard Date class
# We convert to character first to break the 'IDate' class link
data$acq_date <- as.Date(as.character(data$acq_date))
# 3. Ensure numeric columns that might be character in some files are consistent
# (e.g., 'version' or 'type' often cause the next bind_rows error)
if("version" %in% names(data)) data$version <- as.character(data$version)
if("type" %in% names(data))    data$type    <- as.character(data$type)
if("acq_time" %in% names(data)) data$acq_time <- as.character(data$acq_time)
return(data)
}
# Load all available sources
list_of_fires <- list(
archive = load_and_standardize(file_archive),
y2025   = load_and_standardize(file_2025),
latest  = load_and_standardize(file_latest)
)
# Filter out NULLs and combine
# Using purrr::compact or base Filter
clean_list <- Filter(Negate(is.null), list_of_fires)
all_fires_sf <- bind_rows(clean_list)
# -------------------------------
# 1. Load regions
# -------------------------------
regions_list <- load_viirs_regions()
# -------------------------------
# 2. Build monthly summary
# -------------------------------
# build_monthly_summary (from viirs_summary.R) handles the spatial join
monthly_all <- build_monthly_summary(all_fires_sf, regions_list)
# -------------------------------
# 3. Region areas (km²)
# -------------------------------
region_areas <- sapply(regions_list, function(x) {
as.numeric(st_area(x)) / 1e6
})
# -------------------------------
# 4. Monthly fires per km²
# -------------------------------
plot_data <- monthly_all |>
mutate(
area_km2 = region_areas[region],
fires_per_km2 = n_fires / area_km2,
# Ensure month is a factor and year is treated as a category for faceting
month = factor(month, levels = month.name),
year = factor(year)
) |>
filter(region %in% c("GNP", "Mountain", "Buffer"))
# -------------------------------
# 5. Plot: Vertical Facets
# -------------------------------
p <- ggplot(plot_data,
aes(x = month, y = fires_per_km2, fill = region)) +
geom_col(position = "dodge") +
# Facet by year, stacked top-to-bottom
# 'free_x' is not used so months stay aligned; 'space = free' helps if years have missing months
facet_grid(year ~ ., scales = "fixed") +
scale_fill_manual(values = c("GNP" = "#27ae60",
"Mountain" = "#2980b9",
"Buffer" = "#f1c40f")) +
labs(
x = "Month",
y = "Fires per km²",
fill = "Region",
title = "Monthly Fire Density by Year"
) +
theme_minimal(base_size = 12) +
theme(
axis.text.x = element_text(angle = 45, hjust = 1),
legend.position = "bottom",
# Strip formatting for the year labels on the right
strip.text.y = element_text(angle = 0, face = "bold"),
panel.spacing = unit(1, "lines")
)
print(p)
# -------------------------------
# 6. Save plot (Dynamic Height)
# -------------------------------
# Adjust height based on how many years are being plotted
n_years <- length(unique(plot_data$year))
outfile <- "plots/monthly_fires_all_years_stacked.png"
dir.create("plots", showWarnings = FALSE)
ggsave(outfile, plot = p, width = 10, height = 2 * n_years, dpi = 300, bg = "white")
message("Saved multi-year plot: ", outfile)
qc()
gc()
gc()
